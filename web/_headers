# Cloudflare Pages 响应头。国内访客到 CF 边缘节点一次往返要 1~8 秒,所以能缓存的都给 max-age;
# 首页与每日快照必须每次回源,否则当天的更新访客看不到。
# 逐条写死路径而不用 /*.js 通配:通配与 /vendor/* 同时命中时优先级不可靠,
# 万一 our app.js 被 vendor 的长缓存规则盖住,推送后访客会长时间看到旧界面。

/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/data/*
  Cache-Control: public, max-age=0, must-revalidate

/app.js
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/core.js
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/bg3d.js
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/net.js
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/earth-data.js
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/styles.css
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/vendor/*
  Cache-Control: public, max-age=2592000, immutable
